# Dominio definitivo del sitio (sin diagonal final). Se usa en URLs canónicas, Open Graph y sitemap.xml.
# Si no se define, se usa https://dorfic.pages.dev
SITE_URL=https://dorfic.com

# Token de Cloudflare Web Analytics (opcional, sin cookies). Déjalo vacío para no cargar el script.
VITE_CF_BEACON_TOKEN=

# Google AdSense (ca-pub-...). Déjalo vacío para no cargar anuncios reales.
VITE_ADSENSE_CLIENT=
# IDs de bloques de anuncio (data-ad-slot). Con solo DISPLAY basta: los otros dos lo usan si están vacíos.
# Display: debajo de la herramienta, entre el contenido y lateral de escritorio
VITE_ADSENSE_SLOT_DISPLAY=
# Barra fija inferior (siempre visible, se puede cerrar)
VITE_ADSENSE_SLOT_ANCHOR=
# Panel antes de la primera descarga de cada visita
VITE_ADSENSE_SLOT_DOWNLOAD=

# Verificación de propiedad (solo el valor del content="..."):
# Google Search Console → Configuración → Verificación → Etiqueta HTML
VITE_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools → msvalidate.01
VITE_BING_SITE_VERIFICATION=
